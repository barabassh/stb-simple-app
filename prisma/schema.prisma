// Target schema and the reasoning behind it: docs/СХЕМА-БД.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CONTRACTOR
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PASSWORD_CHANGE
  STATUS_CHANGE
  SESSION_REVOKE
  EXPORT
  IMPORT
}

model User {
  id                 String    @id @default(cuid())
  // Stored lowercased: the unique index is case-sensitive in PostgreSQL.
  login              String    @unique
  fullName           String
  // Unique ignoring case: an index on lower("nickname") in the migration, not @unique.
  nickname           String
  position           String?
  email              String?   @unique
  phone              String?
  comment            String?

  passwordHash       String
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)

  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  // Only for the CONTRACTOR role; cleared by the action when the role changes.
  contractorId       String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?
  updatedById        String?

  sessions           Session[]
  auditLogs          AuditLog[] @relation("AuditActor")

  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreatedBy")
  updatedBy          User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedUsers       User[]    @relation("UserUpdatedBy")

  contractor         Contractor? @relation("UserContractor", fields: [contractorId], references: [id], onDelete: Restrict)

  createdCompanyProfiles  CompanyProfile[] @relation("CompanyProfileCreatedBy")
  updatedCompanyProfiles  CompanyProfile[] @relation("CompanyProfileUpdatedBy")
  createdCompanyAddresses CompanyAddress[] @relation("CompanyAddressCreatedBy")
  updatedCompanyAddresses CompanyAddress[] @relation("CompanyAddressUpdatedBy")

  createdCustomers        Customer[]       @relation("CustomerCreatedBy")
  updatedCustomers        Customer[]       @relation("CustomerUpdatedBy")
  createdContractors      Contractor[]     @relation("ContractorCreatedBy")
  updatedContractors      Contractor[]     @relation("ContractorUpdatedBy")
  closedProjects          Project[]        @relation("ProjectClosedBy")
  createdProjects         Project[]        @relation("ProjectCreatedBy")
  updatedProjects         Project[]        @relation("ProjectUpdatedBy")

  workReports             WorkReport[]     @relation("WorkReportUser")
  approvedWorkReports     WorkReport[]     @relation("WorkReportApprovedBy")
  unapprovedWorkReports   WorkReport[]     @relation("WorkReportUnapprovedBy")
  createdWorkReports      WorkReport[]     @relation("WorkReportCreatedBy")
  updatedWorkReports      WorkReport[]     @relation("WorkReportUpdatedBy")

  @@index([role])
  @@index([isActive])
  @@index([fullName])
  @@index([contractorId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  // SHA-256 of the token; a leaked dump must not allow session hijacking.
  tokenHash    String    @unique
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  at         DateTime    @default(now())

  actorId    String?
  // Duplicated on purpose: the log stays readable after actorId is nulled.
  actorLogin String
  action     AuditAction
  // Model name ("User", "Session", ...) so later entities need no table change.
  entity     String
  entityId   String?
  summary    String
  // [{ field, before, after }]
  changes    Json?
  ip         String?
  userAgent  String?

  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
  @@index([actorId, at])
  @@index([action])
}

// Stage 2: company profile (docs/СХЕМА-БД.md, section 8).

enum LegalForm {
  EENMANSZAAK
  VOF
  CV
  BV
  NV
  STICHTING
  VERENIGING
  COOPERATIE
  MAATSCHAP
  OTHER
}

enum CompanyAddressType {
  OFFICE
  POSTAL
  WAREHOUSE
}

enum SocialNetwork {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
  YOUTUBE
  TIKTOK
  OTHER
}

model CompanyProfile {
  id                  String     @id @default(cuid())
  // Only ever true (CHECK in the migration): a concurrent second insert fails on uniqueness.
  singleton           Boolean    @unique @default(true)

  legalName           String
  tradeName           String?
  legalForm           LegalForm?
  // A calendar date from the KvK extract; converting it to a time zone would shift the day.
  registeredOn        DateTime?  @db.Date
  statutorySeat       String?

  kvkNumber           String?
  establishmentNumber String?
  rsin                String?
  vatId               String?
  vatNumber           String?
  payrollTaxNumber    String?

  email               String?
  phone               String?
  website             String?
  activityDescription String?
  postalSameAsOffice  Boolean    @default(true)

  // Optimistic locking: a counter, because updatedAt has limited precision.
  version             Int        @default(1)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdById         String?
  updatedById         String?

  createdBy           User?      @relation("CompanyProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?      @relation("CompanyProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  addresses           CompanyAddress[]
  phones              CompanyPhone[]
  socialLinks         CompanySocialLink[]
  activities          CompanyActivity[]
}

// One active OFFICE and one POSTAL address per company: partial unique index in the migration.
// Warehouses will be referenced by later stages, hence audit fields and soft delete.
model CompanyAddress {
  id                  String             @id @default(cuid())
  companyId           String
  type                CompanyAddressType
  name                String?
  // Empty for a PO box (postbus).
  street              String?
  houseNumber         Int?
  houseNumberAddition String?
  postbus             String?
  postcode            String?
  city                String?
  // ISO 3166-1 alpha-2; names come from Intl.DisplayNames.
  country             String             @default("NL") @db.Char(2)
  sortOrder           Int                @default(0)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  company             CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           User?              @relation("CompanyAddressCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?              @relation("CompanyAddressUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, type])
}

// Phones, social links and activities are replaced as a whole with the profile and nothing
// refers to them, so they deliberately have no audit fields or soft delete.

model CompanyPhone {
  id        String         @id @default(cuid())
  companyId String
  label     String?
  number    String?
  sortOrder Int

  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanySocialLink {
  id        String         @id @default(cuid())
  companyId String
  network   SocialNetwork?
  url       String?
  sortOrder Int

  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyActivity {
  id          String         @id @default(cuid())
  companyId   String
  sbiCode     String?
  description String?
  isMain      Boolean        @default(false)
  sortOrder   Int

  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sbiCode])
}

// Stage 3: customers, contractors and projects (docs/СХЕМА-БД.md, section 9).

enum CustomerType {
  COMPANY
  PERSON
}

enum ProjectStatus {
  IN_PROGRESS
  // Nothing in a closed project may change.
  CLOSED
}

enum VatRate {
  STANDARD_21
  REDUCED_9
  ZERO
  // "Verlegd": the customer accounts for the VAT.
  REVERSE_CHARGE
}

// Customers and contractors are archived (isActive) instead of deleted: projects, the audit log
// and contractor accounts refer to them.
model Customer {
  id                  String        @id @default(cuid())
  type                CustomerType  @default(COMPANY)
  // A company name or a person's full name.
  name                String
  // kvkNumber, vatId and contactPerson are NULL for a PERSON (CHECK in the migration).
  kvkNumber           String?       @unique
  vatId               String?
  contactPerson       String?
  email               String?
  phone               String?

  street              String?
  houseNumber         Int?
  houseNumberAddition String?
  postcode            String?
  city                String?
  // Filled together with the address.
  country             String?       @db.Char(2)

  comment             String?
  isActive            Boolean       @default(true)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?
  updatedById         String?

  createdBy           User?         @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?         @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  projects            Project[]

  @@index([name])
  @@index([isActive])
}

model Contractor {
  id                  String        @id @default(cuid())
  name                String
  legalForm           LegalForm?
  kvkNumber           String?       @unique
  vatId               String?
  contactPerson       String?
  email               String?
  phone               String?

  street              String?
  houseNumber         Int?
  houseNumberAddition String?
  postcode            String?
  city                String?
  country             String?       @db.Char(2)

  comment             String?
  isActive            Boolean       @default(true)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?
  updatedById         String?

  createdBy           User?         @relation("ContractorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?         @relation("ContractorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  users               User[]        @relation("UserContractor")
  workReports         WorkReport[]

  @@index([name])
  @@index([isActive])
}

model Project {
  id                  String        @id @default(cuid())
  // Unique among projects that are not deleted, ignoring case: partial index in the migration.
  number              String
  name                String
  customerId          String

  // The site address.
  street              String
  houseNumber         Int
  houseNumberAddition String?
  postcode            String
  city                String
  country             String        @default("NL") @db.Char(2)

  // A calendar date, like CompanyProfile.registeredOn.
  startDate           DateTime      @db.Date
  description         String?

  // Without VAT, in euros; the amount with VAT is calculated, not stored.
  budgetAmount        Decimal?      @db.Decimal(14, 2)
  vatRate             VatRate?
  budgetHours         Decimal?      @db.Decimal(10, 2)

  status              ProjectStatus @default(IN_PROGRESS)
  closedAt            DateTime?
  closedById          String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  closedBy            User?         @relation("ProjectClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdBy           User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?         @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  workReports         WorkReport[]

  @@index([status, startDate])
  @@index([customerId])
  @@index([name])
}

// Stage 4: work reports (docs/СХЕМА-БД.md, section 10).

enum WorkReportStatus {
  UNAPPROVED
  APPROVED
}

// One day of one worker on one project. Time is the worker's wall clock in minutes from midnight,
// with no time zone; the hours worked are calculated, not stored. Overlapping reports of a worker
// on a day are rejected by an exclusion constraint in the migration.
model WorkReport {
  id                String           @id @default(cuid())
  userId            String
  // The worker's organisation when the report was made; NULL for the company's own employee.
  contractorId      String?
  projectId         String

  workDate          DateTime         @db.Date
  workDescription   String
  startMinute       Int
  endMinute         Int
  lunchMinutes      Int              @default(0)
  mileageKm         Int              @default(0)

  status            WorkReportStatus @default(UNAPPROVED)
  approvedAt        DateTime?
  approvedById      String?
  // The reason of the last unapproval, kept until the report is approved again.
  unapprovalReason  String?
  unapprovedAt      DateTime?
  unapprovedById    String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  user              User             @relation("WorkReportUser", fields: [userId], references: [id], onDelete: Restrict)
  contractor        Contractor?      @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approvedBy        User?            @relation("WorkReportApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  unapprovedBy      User?            @relation("WorkReportUnapprovedBy", fields: [unapprovedById], references: [id], onDelete: SetNull)
  createdBy         User?            @relation("WorkReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?            @relation("WorkReportUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([projectId, workDate])
  @@index([userId, workDate])
  @@index([contractorId, workDate])
  @@index([status, workDate])
}
