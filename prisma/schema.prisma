// Target schema and the reasoning behind it: docs/СХЕМА-БД.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  CONTRACTOR
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PASSWORD_CHANGE
  STATUS_CHANGE
  SESSION_REVOKE
  EXPORT
  IMPORT
}

model User {
  id                 String    @id @default(cuid())
  // Stored lowercased: the unique index is case-sensitive in PostgreSQL.
  login              String    @unique
  fullName           String
  position           String?
  email              String?   @unique
  phone              String?
  comment            String?

  passwordHash       String
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)

  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?
  updatedById        String?

  sessions           Session[]
  auditLogs          AuditLog[] @relation("AuditActor")

  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreatedBy")
  updatedBy          User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedUsers       User[]    @relation("UserUpdatedBy")

  createdCompanyProfiles  CompanyProfile[] @relation("CompanyProfileCreatedBy")
  updatedCompanyProfiles  CompanyProfile[] @relation("CompanyProfileUpdatedBy")
  createdCompanyAddresses CompanyAddress[] @relation("CompanyAddressCreatedBy")
  updatedCompanyAddresses CompanyAddress[] @relation("CompanyAddressUpdatedBy")

  @@index([role])
  @@index([isActive])
  @@index([fullName])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  // SHA-256 of the token; a leaked dump must not allow session hijacking.
  tokenHash    String    @unique
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  at         DateTime    @default(now())

  actorId    String?
  // Duplicated on purpose: the log stays readable after actorId is nulled.
  actorLogin String
  action     AuditAction
  // Model name ("User", "Session", ...) so later entities need no table change.
  entity     String
  entityId   String?
  summary    String
  // [{ field, before, after }]
  changes    Json?
  ip         String?
  userAgent  String?

  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
  @@index([actorId, at])
  @@index([action])
}

// Stage 2: company profile (docs/СХЕМА-БД.md, section 8).

enum LegalForm {
  EENMANSZAAK
  VOF
  CV
  BV
  NV
  STICHTING
  VERENIGING
  COOPERATIE
  MAATSCHAP
  OTHER
}

enum CompanyAddressType {
  OFFICE
  POSTAL
  WAREHOUSE
}

enum SocialNetwork {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
  YOUTUBE
  TIKTOK
  OTHER
}

model CompanyProfile {
  id                  String     @id @default(cuid())
  // Only ever true (CHECK in the migration): a concurrent second insert fails on uniqueness.
  singleton           Boolean    @unique @default(true)

  legalName           String
  tradeName           String?
  legalForm           LegalForm?
  // A calendar date from the KvK extract; converting it to a time zone would shift the day.
  registeredOn        DateTime?  @db.Date
  statutorySeat       String?

  kvkNumber           String?
  establishmentNumber String?
  rsin                String?
  vatId               String?
  vatNumber           String?
  payrollTaxNumber    String?

  email               String?
  phone               String?
  website             String?
  activityDescription String?
  postalSameAsOffice  Boolean    @default(true)

  // Optimistic locking: a counter, because updatedAt has limited precision.
  version             Int        @default(1)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdById         String?
  updatedById         String?

  createdBy           User?      @relation("CompanyProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?      @relation("CompanyProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  addresses           CompanyAddress[]
  phones              CompanyPhone[]
  socialLinks         CompanySocialLink[]
  activities          CompanyActivity[]
}

// One active OFFICE and one POSTAL address per company: partial unique index in the migration.
// Warehouses will be referenced by later stages, hence audit fields and soft delete.
model CompanyAddress {
  id                  String             @id @default(cuid())
  companyId           String
  type                CompanyAddressType
  name                String?
  // Empty for a PO box (postbus).
  street              String?
  houseNumber         Int?
  houseNumberAddition String?
  postbus             String?
  postcode            String?
  city                String?
  // ISO 3166-1 alpha-2; names come from Intl.DisplayNames.
  country             String             @default("NL") @db.Char(2)
  sortOrder           Int                @default(0)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  company             CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           User?              @relation("CompanyAddressCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?              @relation("CompanyAddressUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, type])
}

// Phones, social links and activities are replaced as a whole with the profile and nothing
// refers to them, so they deliberately have no audit fields or soft delete.

model CompanyPhone {
  id        String         @id @default(cuid())
  companyId String
  label     String?
  number    String?
  sortOrder Int

  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanySocialLink {
  id        String         @id @default(cuid())
  companyId String
  network   SocialNetwork?
  url       String?
  sortOrder Int

  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyActivity {
  id          String         @id @default(cuid())
  companyId   String
  sbiCode     String?
  description String?
  isMain      Boolean        @default(false)
  sortOrder   Int

  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sbiCode])
}
