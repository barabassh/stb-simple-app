# Copy to .env and fill in the values: cp .env.example .env

# Password of the "postgres" user in the docker-compose database container.
POSTGRES_PASSWORD=change-me

# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/constructionprojects

# Initial password of the "admin" account created by `npm run db:seed`.
# Min. 10 characters, letters and digits. Only an administrator can change passwords.
SEED_ADMIN_PASSWORD=
